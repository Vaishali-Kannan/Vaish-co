# Environment Variables
# Copy this file to apps/api/.env and fill in your values

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/vaish_and_co"

# ─── Server ──────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Authentication ──────────────────────────────────────────────
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Cookies ─────────────────────────────────────────────────────
COOKIE_SECURE=false  # Set to true in production (HTTPS)
COOKIE_SAME_SITE=lax

# ─── Email Provider (Nodemailer) ─────────────────────────────────
# For development, you can use Ethereal (https://ethereal.email/) for testing
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user
SMTP_PASS=your-ethereal-password
EMAIL_FROM="Vaish&Co. <no-reply@vaishandco.com>"

# ─── AI Provider (Google Gemini) ─────────────────────────────────
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ─── Payment Gateway (Razorpay) ──────────────────────────────────
# Get test keys at https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── Image Storage ───────────────────────────────────────────────
# Uses Cloudinary for production image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# In development, images are served from local public directory

# ─── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Admin Bootstrap ─────────────────────────────────────────────
# Used ONLY once during initial setup to create the first admin account
# Remove from .env after bootstrapping
ADMIN_BOOTSTRAP_SECRET=bootstrap-secret-change-this
